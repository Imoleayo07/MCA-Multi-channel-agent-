        "jsCode": "const rec = $input.first().json;\nconst f = rec.fields ?? rec;\nconst n = $('Normalize Input').first().json;\n\nconst used = new Set(Array.isArray(f['Channels Used']) ? f['Channels Used'] : []);\nused.add(n.channel);\n\nreturn [{ json: {\n  id: rec.id,\n  customer_id: f['Customer ID'],\n  name: f['Name'] || n.sender_name || '',\n  email: f['Email'] || n.sender_email || '',\n  phone: f['Phone'] || n.sender_phone || '',\n  company: f['Company'] || n.company || '',\n  channels_used: [...used],\n  last_interaction: n.received_at\n}}];"

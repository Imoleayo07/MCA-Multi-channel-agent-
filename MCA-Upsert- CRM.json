    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\n// Detect which channel's raw shape this is and normalize into a common shape\nlet i;\n\nif (raw.from !== undefined && raw.textPlain !== undefined) {\n  // Email (Gmail trigger raw shape)\n  const fromMatch = String(raw.from || '').match(/^(.*?)\\s*<(.+?)>$/);\n  i = {\n    sender_name: fromMatch ? fromMatch[1].trim().replace(/^\"|\"$/g, '') : String(raw.from || '').trim(),\n    sender_email: fromMatch ? fromMatch[2].trim().toLowerCase() : '',\n    sender_phone: '',\n    channel: 'email',\n    company: '',\n    received_at: raw.date || new Date().toISOString(),\n    message: raw.textPlain || raw.snippet || ''\n  };\n} else if (raw.data !== undefined) {\n  // WhatsApp (UltraMsg raw shape)\n  i = {\n    sender_name: raw.data.pushname || '',\n    sender_email: '',\n    sender_phone: raw.data.from || '',\n    channel: 'WhatsApp',\n    company: '',\n    received_at: new Date().toISOString(),\n    message: raw.data.body || ''\n  };\n} else {\n  // Website intake — already normalized upstream\n  i = raw;\n}\nlet d = String(i.sender_phone || '').replace(/\\D/g, '');\nif (d.startsWith('00')) d = d.slice(2);\nif (d.startsWith('0')) d = '234' + d.slice(1);\nelse if (d.length === 10) d = '234' + d;\nconst phone = d;\n\nconst email = String(i.sender_email || '').trim().toLowerCase();\nconst esc = s => s.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");\n\nconst parts = [];\nif (email) parts.push(`LOWER({Email})='${esc(email)}'`);\nif (phone) parts.push(`{Phone}='${esc(phone)}'`);\nconst formula = parts.length ? `OR(${parts.join(',')})` : 'FALSE()';\n\nreturn [{ json: { ...i, sender_email: email, sender_phone: phone, formula } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
